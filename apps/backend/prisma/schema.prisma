generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  links Link[]

  @@map("users")
}

model Link {
  id Int @id @default(autoincrement())

  shortCode String @unique @map("short_code") @db.VarChar(32)

  targetUrl String @map("target_url") @db.VarChar(2048)

  targetHash String @map("target_hash") @db.Char(64)

  userId Int? @map("user_id")

  expiresAt DateTime? @map("expires_at")

  clickCount Int @default(0) @map("click_count")

  createdAt DateTime @default(now()) @map("created_at")

  user       User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicks     Click[]
  clickDaily ClickDaily[]

  @@index([userId, createdAt])
  @@index([userId, targetHash])
  @@index([expiresAt])
  @@map("links")
}

model Click {
  id BigInt @id @default(autoincrement())

  linkId    Int      @map("link_id")
  createdAt DateTime @default(now()) @map("created_at")

  device   String? @db.VarChar(32)
  browser  String? @db.VarChar(32)
  referrer String? @db.VarChar(255)
  country  String? @db.Char(2)

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, createdAt])
  @@map("clicks")
}

model ClickDaily {
  linkId Int @map("link_id")

  dimension String @db.VarChar(16)

  date DateTime @db.Date

  value String @db.VarChar(255)

  clicks Int @default(0)

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@id([linkId, dimension, date, value])
  @@map("click_daily")
}
