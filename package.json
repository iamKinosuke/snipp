{
  "name": "snipp",
  "version": "0.1.0",
  "private": true,
  "description": "URL shortener — Redis-cached redirect path with buffered click analytics",
  "license": "MIT",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --workspace=@snipp/backend",
    "dev:frontend": "npm run dev --workspace=@snipp/frontend",
    "build": "npm run build --workspace=@snipp/backend && npm run build --workspace=@snipp/frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "services": "./scripts/dev-services.sh",
    "bench": "node scripts/bench-redirect.mjs"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "concurrently": "^9.2.1"
  }
}
